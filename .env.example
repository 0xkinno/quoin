# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Bedrock Reasoning Model
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Amazon Bedrock AgentCore Memory (Plane C)
AGENTCORE_REGION=us-east-1
AGENTCORE_MEMORY_ID=your-memory-id
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_ARN=

# Authoritative DynamoDB Policy Ledger (Plane B / Channel B)
DYNAMODB_TABLE_NAME=quoin_authority_ledger

# Execution Mode: 'agentcore' for live AWS production path, 'local' for offline test suite
QUOIN_MODE=agentcore

# Frontend & Application
NEXT_PUBLIC_API_URL=http://localhost:8000
